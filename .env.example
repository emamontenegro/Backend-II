# ─── Bootstrap local (lo único que va en .env) ───────────────────
# Servidor (local: 3000 | Docker: 8080 por defecto)
PORT=3000
NODE_ENV=development

# HashiCorp Vault — el resto de los secretos se leen de secret/data/backend
VAULT_URL=http://localhost:8200
VAULT_TOKEN=tu_token_de_vault

# ─── Secretos que viven en VAULT (no en este archivo) ─────────────
# Cargalos con:
#   vault kv put secret/backend \
#     MONGO_URI=... JWT_SECRET=... JWT_EXPIRES_IN=24h \
#     SESSION_SECRET=... SESSION_TIMEOUT=3600000 BCRYPT_ROUNDS=10 \
#     GOOGLE_CLIENT_ID=... GOOGLE_CLIENT_SECRET=... \
#     GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback \
#     CONFIG_LEVEL=high CLIENT_URL=http://localhost:5173
#
# Sin Vault (fallback): podés definir esas mismas variables acá abajo
# y la app las usa igual si VAULT_URL/VAULT_TOKEN no están seteadas.
