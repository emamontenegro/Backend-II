# Environment variables for the application
PORT=3000

# Database configuration
MONGO_URI=mongodb://tu_usuario:tu_contraseña@localhost:27017/tu_base_de_datos

# JWT configuration
JWT_SECRET=tu_secreto_jwt_muy_seguro

# Session configuration
SESSION_SECRET=tu_secreto_de_sesion_muy_seguro
SESSION_TIMEOUT=3600000

# Security configuration
BCRYPT_ROUNDS=10
COOKIE_SECRET=clave_para_firmar_cookies_httpOnly

# Google OAuth — credenciales de la aplicación en Google Cloud (OAuth 2.0 Client ID).
# NO confundir con el id de cuenta del usuario guardado en MongoDB como googleSubjectId.
GOOGLE_CLIENT_ID=tu_google_client_id
GOOGLE_CLIENT_SECRET=tu_google_client_secret
