# Servidor
PORT=3000
NODE_ENV=development

# Frontend (CORS) — URL desde la que corre tu cliente en desarrollo
CLIENT_URL=http://localhost:5173

# MongoDB (Atlas o local). En Atlas usá formato mongodb+srv://
# Si la contraseña tiene caracteres especiales (@, #, etc.), codificala en URL (ej. @ → %40)
MONGO_URI=mongodb+srv://usuario:contraseña@cluster0.xxxxx.mongodb.net/nombre_base?appName=Cluster0

# JWT — firma del token enviado en body y cookie authToken
JWT_SECRET=genera_un_secreto_largo_aleatorio

# express-session + connect-mongo (colección sessions en MongoDB)
SESSION_SECRET=otro_secreto_largo_aleatorio
SESSION_TIMEOUT=3600000

# bcrypt — rondas al hashear contraseñas en registro
BCRYPT_ROUNDS=10

# Google OAuth 2.0 (Google Cloud Console → Credentials → OAuth client)
# Callback autorizado: http://localhost:3000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_google_client_secret

# Opcional / legado: ya no se usa si cookie-parser no firma cookies.
# Podés eliminarla de tu .env si no la necesitás para otro proyecto.
# COOKIE_SECRET=secreto_para_cookies_firmadas
